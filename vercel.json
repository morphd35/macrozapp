{
    "routes": [
        {
            "src": "/api/login",
            "dest": "/backend/index.js",
            "methods": [
                "POST"
            ]
        },
        {
            "src": "/api/signup",
            "dest": "/backend/index.js",
            "methods": [
                "POST"
            ]
        },
        {
            "src": "/api/(.*)",
            "dest": "/backend/index.js"
        }
    ],
    "functions": {
        "backend/index.js": {
            "memory": 1024,
            "maxDuration": 10
        }
    },
    "env": {
        "NODE_ENV": "production"
    }
}