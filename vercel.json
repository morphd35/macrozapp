{
    "version": 2,
    "builds": [
        {
            "src": "backend/index.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/login",
            "dest": "backend/index.js"
        },
        {
            "src": "/api/signup",
            "dest": "backend/index.js"
        },
        {
            "src": "/api/(.*)",
            "dest": "backend/index.js"
        }
    ],
    "functions": {
        "backend/index.js": {
            "memory": 1024,
            "maxDuration": 10
        }
    },
    "env": {
        "NODE_ENV": "production"
    }
}