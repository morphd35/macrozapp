{
    "routes": [
        {
            "src": "/api/login",
            "dest": "backend/routes/login.js"
        },
        {
            "src": "/api/signup",
            "dest": "backend/routes/signup.js"
        },
        {
            "src": "/api/(.*)",
            "dest": "backend/index.js"
        }
    ],
    "functions": {
        "api/login.js": {
            "memory": 1024,
            "maxDuration": 10
        },
        "api/signup.js": {
            "memory": 1024,
            "maxDuration": 10
        },
        "index.js": {
            "memory": 1024,
            "maxDuration": 10
        }
    },
    "env": {
        "NODE_ENV": "production"
    }
}