# Local backend environment
NODE_ENV=development
PORT=4000

# Keep DATABASE_URL unset for local safety
# DATABASE_URL=

# Local Postgres connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=macro_tracker
DB_USER=postgres
DB_PASSWORD=postgres

# Auth
JWT_SECRET=replace_me_local

# Email (optional for password reset)
EMAIL_USER=
EMAIL_PASS=

# Stripe (optional for payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Edamam (optional for premium food lookup)
EDAMAM_FOOD_DATABASE_APP_ID=
EDAMAM_FOOD_DATABASE_APP_KEY=
